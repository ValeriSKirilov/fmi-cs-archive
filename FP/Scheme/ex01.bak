#lang racket

(/ (+ 100 50) (* 10 3))

(+ 1/3 2.25 (/ (-(expt 7 (remainder 60 7)) (* 3 (quotient 21 6))) 11))

(define a 8)

(define b 15)

(define c (sqrt (+ (expt a 2) (expt b 2))))

(define pi 3.141592)

(define (square x) (* x x))

(define (CircleArea r) (* pi (square r)))

(define (CylVol r h) (* pi (CircleArea r) h))

(define (grade-label grade) (
                       if (< grade 3)
                          (error "Скъсаха ме")
                          (error "Пръснах ги")
                          )
  )