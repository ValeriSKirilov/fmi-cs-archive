# Копирайте като .env. .env е в .gitignore, никога не го качвайте в git.

# Генеративен модел: "ollama" (локален, по подразбиране) | "openai" | "anthropic"
GEN_PROVIDER=ollama

# Адрес на базата (по подразбиране пасва на docker-compose.yml):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vectors

# Нужни само при облачен доставчик:
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Локални модели (Ollama):
#   ollama pull bge-m3                    # embeddings, многоезичен (Тема 5)
#   bggpt:4b                              # генериране, вж. README за инсталация
