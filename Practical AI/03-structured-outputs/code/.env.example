# Копирайте този файл като .env:
#     cp .env.example .env
# .env е в .gitignore — НИКОГА не го commit-вайте в git.

# Доставчик по подразбиране: ollama (локално, без ключ) или anthropic.
LLM_PROVIDER=ollama

# Локалният модел от Упражнение 1 (BgGPT).
# За пускане с друг модел: напр. --model llama3.2:1b
OLLAMA_MODEL=bggpt:4b

# Само за --provider anthropic и Задача 3 (бонус).
# Console API ключ от https://console.anthropic.com (започва със sk-ant-api...).
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5
