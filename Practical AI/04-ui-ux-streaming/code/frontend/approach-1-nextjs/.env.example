# Доставчик: ollama (по подразбиране, локален и без ключ) или anthropic.
PROVIDER=ollama

# Локално (изисква `ollama pull llama3.2`):
# OLLAMA_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.2

# При PROVIDER=anthropic — едно от двете:
# ANTHROPIC_API_KEY=sk-ant-api...
# ANTHROPIC_AUTH_TOKEN=sk-ant-oat...
