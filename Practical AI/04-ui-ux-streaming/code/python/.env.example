# Копирайте този файл като .env:  cp .env.example .env
# .env е в .gitignore — НИКОГА не го commit-вайте в git.

# Ключ НЕ е нужен: по подразбиране всичко е локално (Ollama + BgGPT от Упражнение 1).
OLLAMA_MODEL=bggpt:4b

# Само за --provider openai / anthropic (по избор):
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
