# Копирайте този файл като .env и попълнете ключа си:
#     cp .env.example .env
# .env е в .gitignore — НИКОГА не го commit-вайте в git.

# Console API ключ от https://console.anthropic.com (започва със sk-ant-api...).
ANTHROPIC_API_KEY=sk-ant-...

# Алтернатива на горния (само едното!) — вж. README, секция „API ключ".
# ANTHROPIC_AUTH_TOKEN=sk-ant-oat...

# Нужен само за домашното (Задача 4).
# OPENAI_API_KEY=sk-...

# Ollama работи локално и не изисква ключ.

# Проверете средата с:  python check_setup.py
